# 提示词增强器配置
# 说明：这个文件会被 core.py 自动读取（同目录 config.env），
#       已存在的系统环境变量优先级更高，不会被这里覆盖。
#       改完不用重启什么，下次运行脚本即生效。

# ── 增强模型（必填）───────────────────────────────────────────
# 建议用一个便宜、快、稳定的对话模型，别用推理模型（reasoning 模型慢且贵）。
ENHANCER_BASE_URL=https://api.openai.com/v1
ENHANCER_API_KEY=your-api-key-here
ENHANCER_MODEL=gpt-4o-mini

# ── 代理模式（只有 proxy.py 需要）─────────────────────────────
# 你要代理的上游地址。用 CC Switch 本地代理就地加一层时，通常就是：
#   ENHANCER_UPSTREAM_BASE=http://127.0.0.1:15721/v1
ENHANCER_UPSTREAM_BASE=

# ── 可选 ─────────────────────────────────────────────────────
# 代理监听端口（默认 18765，避开 Windows 保留端口段）
# ENHANCER_PROXY_PORT=18765
# 短于这个长度的输入不增强（默认 4）
# ENHANCER_MIN_LEN=4
# 热键默认 ctrl+alt+e
# ENHANCER_HOTKEY=ctrl+alt+e
# 强制所有请求不走系统代理（沙箱/公司网络注入 http_proxy 时有用）
# ENHANCER_NO_PROXY=1
# 自定义模板（指向你自己的 md/txt 文件，留空则用内置模板）
# ENHANCER_SYSTEM_FILE=
# ENHANCER_USER_FILE=

# ── 自测用（不开外网，配合 tools/mock_llm.py 验证链路）────────
# ENHANCER_BASE_URL=https://api.openai.com/v1
# ENHANCER_API_KEY=your-api-key-here
# ENHANCER_MODEL=gpt-4o-mini
# ENHANCER_UPSTREAM_BASE=http://127.0.0.1:18080/v1
